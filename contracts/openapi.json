{
  "openapi": "3.1.0",
  "info": {
    "title": "TITAN API",
    "version": "1"
  },
  "paths": {
    "/api/v1/devices": {
      "post": {
        "summary": "Add Device",
        "description": "Sign in with a username and password and get a token for this device.\n\nA device that still holds its token sends it as a bearer token; then its\ntoken is replaced instead of pairing a new device (decision #24).",
        "operationId": "add_device",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceRegistrationIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceRegistrationOut"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          },
          {}
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "summary": "Whoami",
        "description": "Tell who is signed in on the device that sent this request.",
        "operationId": "whoami",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoamiOut"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "DeviceRegistrationIn": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "format": "password",
            "title": "Password",
            "writeOnly": true
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password",
          "name"
        ],
        "title": "DeviceRegistrationIn",
        "description": "A sign-in: the account's credentials and a name for this device."
      },
      "DeviceRegistrationOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "token": {
            "type": "string",
            "title": "Token"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "token"
        ],
        "title": "DeviceRegistrationOut",
        "description": "The paired device and its token, shown to the device this one time."
      },
      "WhoamiDeviceOut": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "WhoamiDeviceOut",
        "description": "The device the request came from."
      },
      "WhoamiOut": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "device": {
            "$ref": "#/components/schemas/WhoamiDeviceOut"
          }
        },
        "type": "object",
        "required": [
          "username",
          "device"
        ],
        "title": "WhoamiOut",
        "description": "Who is signed in and on which device (accounts.md, sign in, criterion 5)."
      },
      "FieldError": {
        "description": "One invalid field of a request, without the value that was sent.",
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "Problem": {
        "description": "An error answer (RFC 9457); every error of the API has this shape.",
        "properties": {
          "type": {
            "title": "Type",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Errors"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "The device token, titan_v1_…",
        "scheme": "bearer"
      }
    }
  }
}
