{
  "openapi": "3.1.0",
  "info": {
    "title": "TITAN API",
    "version": "1"
  },
  "paths": {
    "/api/v1/chat/threads": {
      "post": {
        "summary": "Create Thread",
        "description": "Start a new, empty thread.",
        "operationId": "create_thread",
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadOut"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/chat/threads/{thread_id}/messages": {
      "post": {
        "summary": "Send Message",
        "description": "Send a message and get the agent's reply as server-sent events.\n\nEvery event's data is one JSON object whose `type` says what it is. The\nstream ends with `done` or `error`. A client that disconnects loses\nnothing: the turn runs to the end and its reply is stored.",
        "operationId": "send_message",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Thread Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string",
                      "contentMediaType": "application/json",
                      "contentSchema": {
                        "oneOf": [
                          {
                            "$ref": "#/components/schemas/ChatTextEvent"
                          },
                          {
                            "$ref": "#/components/schemas/ChatToolCallEvent"
                          },
                          {
                            "$ref": "#/components/schemas/ChatDoneEvent"
                          },
                          {
                            "$ref": "#/components/schemas/ChatErrorEvent"
                          }
                        ],
                        "discriminator": {
                          "propertyName": "type",
                          "mapping": {
                            "text": "#/components/schemas/ChatTextEvent",
                            "tool_call": "#/components/schemas/ChatToolCallEvent",
                            "done": "#/components/schemas/ChatDoneEvent",
                            "error": "#/components/schemas/ChatErrorEvent"
                          }
                        },
                        "title": "Streamitem Send Message"
                      }
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices": {
      "post": {
        "summary": "Add Device",
        "description": "Sign in with a username and password and get a token for this device.\n\nA device that still holds its token sends it as a bearer token; then its\ntoken is replaced instead of pairing a new device (decision #24).",
        "operationId": "add_device",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceRegistrationIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceRegistrationOut"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          },
          {}
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "summary": "Whoami",
        "description": "Tell who is signed in on the device that sent this request.",
        "operationId": "whoami",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoamiOut"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ChatDoneEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "done",
            "title": "Type",
            "default": "done"
          },
          "message_id": {
            "type": "string",
            "format": "uuid",
            "title": "Message Id"
          }
        },
        "type": "object",
        "required": [
          "type",
          "message_id"
        ],
        "title": "ChatDoneEvent",
        "description": "The reply is complete and stored; the stream ends."
      },
      "ChatErrorEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "error",
            "title": "Type",
            "default": "error"
          },
          "title": {
            "type": "string",
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "type",
          "title"
        ],
        "title": "ChatErrorEvent",
        "description": "The turn failed and nothing of it was kept; the stream ends."
      },
      "ChatTextEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "text",
            "title": "Type",
            "default": "text"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "type",
          "text"
        ],
        "title": "ChatTextEvent",
        "description": "The next piece of the reply's text, as Claude writes it."
      },
      "ChatToolCallEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "tool_call",
            "title": "Type",
            "default": "tool_call"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "ok": {
            "type": "boolean",
            "title": "Ok"
          }
        },
        "type": "object",
        "required": [
          "type",
          "name",
          "summary",
          "ok"
        ],
        "title": "ChatToolCallEvent",
        "description": "A tool call that ran: its name, a line a person can read, its outcome."
      },
      "DeviceRegistrationIn": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "format": "password",
            "title": "Password",
            "writeOnly": true
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password",
          "name"
        ],
        "title": "DeviceRegistrationIn",
        "description": "A sign-in: the account's credentials and a name for this device."
      },
      "DeviceRegistrationOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "token": {
            "type": "string",
            "title": "Token"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "token"
        ],
        "title": "DeviceRegistrationOut",
        "description": "The paired device and its token, shown to the device this one time."
      },
      "MessageIn": {
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text",
            "description": "At most as many characters as the user's limit allows, 20000 by default."
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "MessageIn",
        "description": "What the user wrote."
      },
      "ThreadOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "ThreadOut",
        "description": "A new thread."
      },
      "WhoamiDeviceOut": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "WhoamiDeviceOut",
        "description": "The device the request came from."
      },
      "WhoamiOut": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "device": {
            "$ref": "#/components/schemas/WhoamiDeviceOut"
          }
        },
        "type": "object",
        "required": [
          "username",
          "device"
        ],
        "title": "WhoamiOut",
        "description": "Who is signed in and on which device (accounts.md, sign in, criterion 5)."
      },
      "FieldError": {
        "description": "One invalid field of a request, without the value that was sent.",
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "Problem": {
        "description": "An error answer (RFC 9457); every error of the API has this shape.",
        "properties": {
          "type": {
            "title": "Type",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Errors"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "The device token, titan_v1_…",
        "scheme": "bearer"
      }
    }
  }
}
