{
  "openapi": "3.1.0",
  "info": {
    "title": "TITAN API",
    "version": "1"
  },
  "paths": {
    "/api/v1/approvals": {
      "get": {
        "summary": "List Approvals",
        "description": "The signed-in user's pending approval requests, oldest first.",
        "operationId": "list_approvals",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "At most the node's maximum page size, larger is capped; 100 by default. Missing means the maximum.",
              "title": "Limit"
            },
            "description": "At most the node's maximum page size, larger is capped; 100 by default. Missing means the maximum."
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The `next` of the page before.",
              "title": "After"
            },
            "description": "The `next` of the page before."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalPage"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/approvals/{approval_id}/approve": {
      "post": {
        "summary": "Approve Request",
        "description": "Approve a pending request: run its call as stored, and tell its thread.\n\nThe answer is 200 whether the call ran or failed; `status` says which.",
        "operationId": "approve_request",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "approval_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Approval Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalOut"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/approvals/{approval_id}/reject": {
      "post": {
        "summary": "Reject Request",
        "description": "Reject a pending request: its call never runs, and its thread is told.",
        "operationId": "reject_request",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "approval_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Approval Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalOut"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/audit/entries": {
      "get": {
        "summary": "List Entries",
        "description": "The signed-in user's audit log, newest first: every call and every undo.",
        "operationId": "list_entries",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "At most the node's maximum page size, larger is capped; 100 by default. Missing means the maximum.",
              "title": "Limit"
            },
            "description": "At most the node's maximum page size, larger is capped; 100 by default. Missing means the maximum."
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The `next` of the page before.",
              "title": "After"
            },
            "description": "The `next` of the page before."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditEntryPage"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/audit/entries/{entry_id}/undo": {
      "post": {
        "summary": "Undo Entry",
        "description": "Undo an action from its entry, whole; answer with the undo's own entry.\n\nEvery refusal is 409 with a plain detail: never ran, cannot be undone,\nalready undone, older than one year, or changed later.",
        "operationId": "undo_entry",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "entry_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Entry Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditEntryOut"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat/threads": {
      "post": {
        "summary": "Create Thread",
        "description": "Start a new, empty thread.",
        "operationId": "create_thread",
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadOut"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/chat/threads/{thread_id}/messages": {
      "post": {
        "summary": "Send Message",
        "description": "Send a message and get the agent's reply as server-sent events.\n\nEvery event's data is one JSON object whose `type` says what it is. The\nstream ends with `done` or `error`. A client that disconnects loses\nnothing: the turn runs to the end and its reply is stored.",
        "operationId": "send_message",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Thread Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string",
                      "contentMediaType": "application/json",
                      "contentSchema": {
                        "oneOf": [
                          {
                            "$ref": "#/components/schemas/ChatTextEvent"
                          },
                          {
                            "$ref": "#/components/schemas/ChatToolCallEvent"
                          },
                          {
                            "$ref": "#/components/schemas/ChatDoneEvent"
                          },
                          {
                            "$ref": "#/components/schemas/ChatErrorEvent"
                          }
                        ],
                        "discriminator": {
                          "propertyName": "type",
                          "mapping": {
                            "text": "#/components/schemas/ChatTextEvent",
                            "tool_call": "#/components/schemas/ChatToolCallEvent",
                            "done": "#/components/schemas/ChatDoneEvent",
                            "error": "#/components/schemas/ChatErrorEvent"
                          }
                        },
                        "title": "Streamitem Send Message"
                      }
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices": {
      "post": {
        "summary": "Add Device",
        "description": "Sign in with a username and password and get a token for this device.\n\nA device that still holds its token sends it as a bearer token; then its\ntoken is replaced instead of pairing a new device (decision #24).",
        "operationId": "add_device",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceRegistrationIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceRegistrationOut"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          },
          {}
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "summary": "Whoami",
        "description": "Tell who is signed in on the device that sent this request.",
        "operationId": "whoami",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoamiOut"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/policy/modes": {
      "get": {
        "summary": "List Modes",
        "description": "The mode every action class runs in, in every domain, and whose it is.",
        "operationId": "list_modes",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PolicyModeOut"
                  },
                  "type": "array",
                  "title": "Response List Modes"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/policy/modes/{domain}/{action_class}": {
      "put": {
        "summary": "Set Mode",
        "description": "Set the user's own mode for one action class in one domain.\n\nexternal and destructive can only be confirm or deny (decision #116).",
        "operationId": "set_mode",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "domain",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Domain"
            }
          },
          {
            "name": "action_class",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActionClass"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PolicyModeIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyModeOut"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Reset Mode",
        "description": "Return one action class in one domain to its default mode.",
        "operationId": "reset_mode",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "domain",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Domain"
            }
          },
          {
            "name": "action_class",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ActionClass"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActionClass": {
        "type": "string",
        "enum": [
          "read",
          "write-internal",
          "external",
          "destructive"
        ],
        "title": "ActionClass",
        "description": "How much a call can change, which sets its default mode (decision #38).\n\nA user can change the mode of one class in one domain (decision #10)."
      },
      "ApprovalOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "description": "The call's audit entry."
          },
          "tool": {
            "type": "string",
            "title": "Tool"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "domain": {
            "$ref": "#/components/schemas/Domain"
          },
          "action_class": {
            "$ref": "#/components/schemas/ActionClass"
          },
          "status": {
            "$ref": "#/components/schemas/EntryStatus"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At",
            "description": "When a pending request expires: its creation time plus the node's setting in effect now (decision #127)."
          }
        },
        "type": "object",
        "required": [
          "id",
          "tool",
          "summary",
          "domain",
          "action_class",
          "status",
          "created_at",
          "expires_at"
        ],
        "title": "ApprovalOut",
        "description": "A call that waits, or waited, for the user's approval."
      },
      "ApprovalPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ApprovalOut"
            },
            "type": "array",
            "title": "Items"
          },
          "next": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next",
            "description": "Send it back as `after` for the next page; null on the last."
          }
        },
        "type": "object",
        "required": [
          "items",
          "next"
        ],
        "title": "ApprovalPage",
        "description": "A page of approval requests, oldest first (decision #124)."
      },
      "AuditEntryOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "tool": {
            "type": "string",
            "title": "Tool"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "domain": {
            "$ref": "#/components/schemas/Domain"
          },
          "action_class": {
            "$ref": "#/components/schemas/ActionClass"
          },
          "mode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Mode"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mode the policy ran the call in; null for an undo."
          },
          "status": {
            "$ref": "#/components/schemas/EntryStatus"
          },
          "undoable": {
            "type": "boolean",
            "title": "Undoable",
            "description": "Whether the call's tool could be undone when it was called."
          },
          "undoes_entry_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Undoes Entry Id",
            "description": "For an undo, the entry it took back; null otherwise."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "tool",
          "summary",
          "domain",
          "action_class",
          "mode",
          "status",
          "undoable",
          "undoes_entry_id",
          "created_at"
        ],
        "title": "AuditEntryOut",
        "description": "One call in the user's audit log, or an undo (decisions #108, #131)."
      },
      "AuditEntryPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AuditEntryOut"
            },
            "type": "array",
            "title": "Items"
          },
          "next": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next",
            "description": "Send it back as `after` for the next page; null on the last."
          }
        },
        "type": "object",
        "required": [
          "items",
          "next"
        ],
        "title": "AuditEntryPage",
        "description": "A page of the user's audit log, newest first (decision #124)."
      },
      "ChatDoneEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "done",
            "title": "Type",
            "default": "done"
          },
          "message_id": {
            "type": "string",
            "format": "uuid",
            "title": "Message Id"
          }
        },
        "type": "object",
        "required": [
          "type",
          "message_id"
        ],
        "title": "ChatDoneEvent",
        "description": "The reply is complete and stored; the stream ends."
      },
